#!/bin/bash
set -euo pipefail

cd /Users/moldovancsaba/Projects/hatori

echo "== Hatori planning check ==" 

echo "-- Repo sanity"
pwd
ls >/dev/null

echo "-- DB status"
make status

echo "-- Reset + tests"
make reset
make test

echo "-- UI import sanity"
. .venv/bin/activate && python -c "import ui.app as m; print(\"UI app present:\", hasattr(m, \"app\"))"

echo "OK: planning check complete"
