import AppKit
import Foundation
import CoreText

final class HatoriMenubarApp: NSObject, NSApplicationDelegate {
    private let statusItem = NSStatusBar.system.statusItem(withLength: NSStatusItem.variableLength)
    private let menu = NSMenu()
    private let productItem = NSMenuItem(title: "{hatori} v__APP_VERSION__", action: nil, keyEquivalent: "")
    private let healthItem = NSMenuItem(title: "Health: checking...", action: nil, keyEquivalent: "")
    private let detailItem = NSMenuItem(title: "", action: nil, keyEquivalent: "")
    private let runtimeItem = NSMenuItem(title: "Runtimes: ...", action: nil, keyEquivalent: "")
    private let writerItem = NSMenuItem(title: "Writer: ...", action: nil, keyEquivalent: "")
    private let drafterItem = NSMenuItem(title: "Drafter: ...", action: nil, keyEquivalent: "")
    private let judgeItem = NSMenuItem(title: "Judge: ...", action: nil, keyEquivalent: "")
    private let basicsHeaderItem = NSMenuItem(title: "--- Basics ---", action: nil, keyEquivalent: "")
    private let advancedHeaderItem = NSMenuItem(title: "--- Advanced ---", action: nil, keyEquivalent: "")
    private var timer: Timer?
    private let repoRoot = "__REPO_ROOT__"
    private var iconFont: NSFont?
    private var uiPort = "23571"
    private var apiPort = "23572"

    func applicationDidFinishLaunching(_ notification: Notification) {
        loadPortsFromEnv()
        configureMenuBarIcon()

        productItem.isEnabled = false
        healthItem.isEnabled = false
        detailItem.isEnabled = false
        runtimeItem.isEnabled = false
        writerItem.isEnabled = false
        drafterItem.isEnabled = false
        judgeItem.isEnabled = false
        basicsHeaderItem.isEnabled = false
        advancedHeaderItem.isEnabled = false

        menu.addItem(productItem)
        menu.addItem(healthItem)
        menu.addItem(detailItem)
        menu.addItem(runtimeItem)
        menu.addItem(writerItem)
        menu.addItem(drafterItem)
        menu.addItem(judgeItem)
        menu.addItem(NSMenuItem.separator())
        menu.addItem(basicsHeaderItem)
        menu.addItem(item("Open UI /chat", #selector(openUI)))
        menu.addItem(item("Open UI /upload", #selector(openUIUpload)))
        menu.addItem(item("Open UI /search", #selector(openUISearch)))
        menu.addItem(item("Open API Health", #selector(openAPIHealth)))
        menu.addItem(item("Documentation", #selector(openDocumentation)))
        menu.addItem(item("Reply Smoke", #selector(runReplySmoke)))

        menu.addItem(NSMenuItem.separator())
        menu.addItem(advancedHeaderItem)
        menu.addItem(item("Open UI /interactions", #selector(openUIInteractions)))
        menu.addItem(item("Open UI /learning", #selector(openUILearning)))
        menu.addItem(item("Restart Service", #selector(restartService)))
        menu.addItem(item("Stop Service", #selector(stopService)))
        menu.addItem(item("Start/Install Service", #selector(installService)))
        menu.addItem(item("Service Logs", #selector(openLogs)))
        menu.addItem(NSMenuItem.separator())
        menu.addItem(item("Quit", #selector(quitApp)))

        statusItem.menu = menu
        refreshHealth()
        timer = Timer.scheduledTimer(timeInterval: 5.0, target: self, selector: #selector(refreshHealth), userInfo: nil, repeats: true)
    }

    private func loadPortsFromEnv() {
        let envPath = FileManager.default.homeDirectoryForCurrentUser
            .appendingPathComponent(".config/hatori/hatori.env").path
        guard let text = try? String(contentsOfFile: envPath, encoding: .utf8) else { return }
        for rawLine in text.components(separatedBy: .newlines) {
            let line = rawLine.trimmingCharacters(in: .whitespacesAndNewlines)
            if line.isEmpty || line.hasPrefix("#") { continue }
            let parts = line.split(separator: "=", maxSplits: 1).map(String.init)
            if parts.count != 2 { continue }
            let key = parts[0].trimmingCharacters(in: .whitespaces)
            let value = parts[1].trimmingCharacters(in: .whitespaces)
            if key == "UI_PORT", !value.isEmpty { uiPort = value }
            if key == "API_PORT", !value.isEmpty { apiPort = value }
        }
    }

    private func configureMenuBarIcon() {
        guard let button = statusItem.button else { return }
        let bundled = Bundle.main.url(forResource: "MaterialSymbolsOutlined", withExtension: "ttf")
        let fontURL = bundled ?? URL(fileURLWithPath: repoRoot)
            .appendingPathComponent("tools/macos/HatoriMenubar/MaterialSymbolsOutlined.ttf")
        if FileManager.default.fileExists(atPath: fontURL.path) {
            CTFontManagerRegisterFontsForURL(fontURL as CFURL, .process, nil)
        }
        if let font = NSFont(name: "Material Symbols Outlined", size: 18) {
            iconFont = font
            button.imagePosition = .imageOnly
            button.image = makeGlyphImage(font: font, color: .labelColor)
            return
        }
        button.title = "H"
    }

    private func item(_ title: String, _ action: Selector) -> NSMenuItem {
        let m = NSMenuItem(title: title, action: action, keyEquivalent: "")
        m.target = self
        return m
    }

    private func runShell(_ command: String) {
        let process = Process()
        process.executableURL = URL(fileURLWithPath: "/bin/bash")
        process.arguments = ["-lc", "cd \(repoRoot) && \(command)"]
        process.standardOutput = Pipe()
        process.standardError = Pipe()
        do {
            try process.run()
        } catch {
            healthItem.title = "Health: command failed"
            detailItem.title = "Failed to run: \(command)"
        }
    }

    private func boolState(_ value: Any?) -> String {
        guard let ok = value as? Bool else { return "unknown" }
        return ok ? "up" : "down"
    }

    private func modelLaneTitle(_ lane: String, data: [String: Any]?) -> String {
        guard let data else { return "\(lane): unknown" }
        let backend = (data["backend"] as? String) ?? "none"
        let model = (data["model"] as? String) ?? ""
        let fallback = (data["fallback_used"] as? Bool) == true ? " (fallback)" : ""
        let ok = (data["ok"] as? Bool) == true
        let state = ok ? "ok" : "down"
        if model.isEmpty {
            return "\(lane): \(backend) [\(state)]\(fallback)"
        }
        return "\(lane): \(backend)/\(model) [\(state)]\(fallback)"
    }

    private func trunc(_ value: String, limit: Int = 80) -> String {
        if value.count <= limit { return value }
        return String(value.prefix(limit - 1)) + "…"
    }

    @objc private func refreshHealth() {
        guard let url = URL(string: "http://127.0.0.1:\(apiPort)/v1/health") else { return }
        let task = URLSession.shared.dataTask(with: url) { data, response, _ in
            DispatchQueue.main.async {
                guard
                    let http = response as? HTTPURLResponse,
                    http.statusCode == 200,
                    let data = data,
                    let obj = try? JSONSerialization.jsonObject(with: data) as? [String: Any]
                else {
                    self.updateIconColor(isUp: false)
                    self.healthItem.title = "Health: API down"
                    self.detailItem.title = "DB: unknown  API: \(self.apiPort)"
                    self.runtimeItem.title = "Runtimes: MLX down, Ollama down"
                    self.writerItem.title = "Writer: unavailable"
                    self.drafterItem.title = "Drafter: unavailable"
                    self.judgeItem.title = "Judge: unavailable"
                    return
                }

                let db = (obj["db"] as? String) ?? "unknown"
                let model = (obj["model"] as? String) ?? "unknown"
                let modelName = (obj["model_name"] as? String) ?? ""
                let runtime = (obj["runtime_status"] as? [String: Any]) ?? [:]
                let mlx = (runtime["mlx"] as? [String: Any]) ?? [:]
                let ollama = (runtime["ollama"] as? [String: Any]) ?? [:]
                let routing = (obj["task_model_routing"] as? [String: Any]) ?? [:]
                let writer = routing["writer"] as? [String: Any]
                let drafter = routing["drafter"] as? [String: Any]
                let judge = routing["judge"] as? [String: Any]

                self.updateIconColor(isUp: true)
                self.healthItem.title = "Health: API up"
                self.detailItem.title = self.trunc("DB: \(db)  Primary: \(model)\(modelName.isEmpty ? "" : "/\(modelName)")")
                self.runtimeItem.title = self.trunc("Runtimes: MLX \(self.boolState(mlx["ok"])), Ollama \(self.boolState(ollama["ok"]))")
                self.writerItem.title = self.trunc(self.modelLaneTitle("Writer", data: writer))
                self.drafterItem.title = self.trunc(self.modelLaneTitle("Drafter", data: drafter))
                self.judgeItem.title = self.trunc(self.modelLaneTitle("Judge", data: judge))
            }
        }
        task.resume()
    }

    private func updateIconColor(isUp: Bool) {
        guard let button = statusItem.button else { return }
        guard let font = iconFont else { return }
        let color: NSColor = isUp ? .labelColor : .systemRed
        button.imagePosition = .imageOnly
        button.image = makeGlyphImage(font: font, color: color)
    }

    private func makeGlyphImage(font: NSFont, color: NSColor) -> NSImage {
        let size = NSSize(width: 18, height: 18)
        let image = NSImage(size: size)
        image.lockFocus()
        let attrs: [NSAttributedString.Key: Any] = [
            .font: font,
            .foregroundColor: color
        ]
        let glyph = NSString(string: "comment")
        let textSize = glyph.size(withAttributes: attrs)
        let rect = NSRect(
            x: (size.width - textSize.width) / 2.0,
            y: (size.height - textSize.height) / 2.0 - 0.5,
            width: textSize.width,
            height: textSize.height
        )
        glyph.draw(in: rect, withAttributes: attrs)
        image.unlockFocus()
        image.isTemplate = false
        return image
    }

    @objc private func openUI() {
        NSWorkspace.shared.open(URL(string: "http://127.0.0.1:\(uiPort)/chat")!)
    }

    @objc private func openUIUpload() {
        NSWorkspace.shared.open(URL(string: "http://127.0.0.1:\(uiPort)/upload")!)
    }

    @objc private func openUISearch() {
        NSWorkspace.shared.open(URL(string: "http://127.0.0.1:\(uiPort)/search")!)
    }

    @objc private func openUIInteractions() {
        NSWorkspace.shared.open(URL(string: "http://127.0.0.1:\(uiPort)/interactions")!)
    }

    @objc private func openUILearning() {
        NSWorkspace.shared.open(URL(string: "http://127.0.0.1:\(uiPort)/learning")!)
    }

    @objc private func openAPIHealth() {
        NSWorkspace.shared.open(URL(string: "http://127.0.0.1:\(apiPort)/v1/health")!)
    }

    @objc private func openDocumentation() {
        NSWorkspace.shared.open(URL(string: "https://github.com/moldovancsaba/hatori#readme")!)
    }

    @objc private func runReplySmoke() {
        runShell("make reply-smoke")
    }

    @objc private func restartService() {
        runShell("make install-service && launchctl kickstart -k gui/$(id -u)/com.hatori")
    }

    @objc private func stopService() {
        runShell("launchctl unload \"$HOME/Library/LaunchAgents/com.hatori.plist\"")
    }

    @objc private func installService() {
        runShell("make install-service")
    }

    @objc private func openLogs() {
        runShell("make service-logs")
        let logPath = FileManager.default.homeDirectoryForCurrentUser
            .appendingPathComponent("Library/Logs/Hatori/hatori.log").path
        NSWorkspace.shared.open(URL(fileURLWithPath: logPath))
    }

    @objc private func quitApp() {
        NSApplication.shared.terminate(nil)
    }
}

let app = NSApplication.shared
let delegate = HatoriMenubarApp()
app.delegate = delegate
app.setActivationPolicy(.accessory)
app.run()
